@model IEnumerable<ProductCardDto>
@{
    ViewData["Title"] = "Home Page";
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-6 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@(item.CoverImagePath ?? "https://placehold.co/400x300?text=Görsel+Yok")" class="card-img-top" alt="@item.Name" />
                <div class="card-body">
                    <a asp-action="index" asp-controller="home" asp-route-StoreName="@item.StoreName.ToUrl()" class="h6 text-muted text-decoration-none">
                        @item.StoreName
                    </a>
                    <h5 class="mb-0 card-title">@item.Name</h5>
                    <a asp-action="index" asp-controller="home" asp-route-CategoryName="@item.CategoryName.ToUrl()" class="h6 text-muted text-decoration-none">
                        @item.CategoryName
                    </a> |
                    <a asp-action="index" asp-controller="home" asp-route-BrandName="@item.BrandName.ToUrl()" class="h6 text-muted text-decoration-none">
                        @item.BrandName
                    </a>
                    <p class="fw-bold">@item.Price.ToString("C")</p>
                    @if (!item.InStock)
                    {
                        <small class="badge bg-danger bg-gradient bg-opacity-50">Stokta Yok!</small>
                    }
                </div>
                <button class="btn btn-sm btn-primary w-100">Sepete Ekle</button>
            </div>
        </div>
    }
</div>
