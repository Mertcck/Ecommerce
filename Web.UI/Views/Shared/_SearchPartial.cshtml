<div class="d-flex">
    <form class="input-group" role="search" method="get" asp-action="index" asp-controller="home">
        <input class="form-control"
               type="search"
               name="searchTerm"
               placeholder="Ürün adında ara..."
               aria-label="Search"
               required
               value="@Context.Request.Query["SearchTerm"]" />
        <button class="btn btn-outline-success" type="submit">Ara</button>
    </form>
</div>
